# MCP AI sidecar (FastAPI) — salin ke MCP/.env lalu isi nilainya.
# JANGAN commit MCP/.env (berisi rahasia).

# Database (sama dengan DB Laravel)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=final_pvc

# Gemini API key — buat di https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Token rahasia untuk autentikasi internal antara Laravel <-> service ini.
# Harus sama dengan nilai yang dipakai aplikasi Laravel saat memanggil endpoint MCP.
INTERNAL_TOKEN=
